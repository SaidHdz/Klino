{
  "$brand": "Klino",
  "$version": "1.0",
  "$owner": "Ravyn Studio",
  "color": {
    "papel": { "value": "#F4F1EA", "role": "fondo dominante" },
    "papelHondo": { "value": "#EDE8DE", "role": "superficies, tarjetas" },
    "tinta": { "value": "#16191B", "role": "texto" },
    "verde": { "value": "#1F5F4B", "role": "primario" },
    "ambar": { "value": "#E0913A", "role": "acento y estado: requiere tu revisión" },
    "ambarTinta": { "value": "#8A5311", "role": "ámbar cuando debe ser texto" },
    "gris": { "value": "#63635B", "role": "metadatos y etiquetas" },
    "error": { "value": "#B0311F", "role": "estados destructivos" },
    "border": { "value": "rgba(22,25,27,0.16)", "role": "filete" },
    "borderStrong": { "value": "rgba(22,25,27,0.32)", "role": "filete de énfasis" }
  },
  "font": {
    "display": { "value": "Familjen Grotesk", "weight": 600, "source": "https://fonts.google.com/specimen/Familjen+Grotesk" },
    "body": { "value": "Spectral", "weight": [400, 500], "source": "https://fonts.google.com/specimen/Spectral" }
  },
  "fontSize": {
    "h1": "52px",
    "h2": "34px",
    "h3": "24px",
    "subtitle": "22px",
    "body": "17px",
    "small": "15px",
    "label": "13px"
  },
  "lineHeight": {
    "h1": 1.05,
    "h2": 1.12,
    "h3": 1.2,
    "subtitle": 1.45,
    "body": 1.62,
    "small": 1.55,
    "label": 1
  },
  "letterSpacing": {
    "h1": "-0.015em",
    "label": "0.24em",
    "wordmark": "0.09em"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "44px",
    "8": "56px",
    "9": "72px"
  },
  "radius": {
    "none": "0px",
    "appIcon": "22%"
  },
  "shadow": {
    "none": "none"
  },
  "icon": {
    "strokeWidth": "1.75px",
    "lineCap": "butt",
    "lineJoin": "miter",
    "grid": "24px",
    "library": "Lucide"
  },
  "contrast": {
    "tintaSobrePapel": "15.6:1",
    "papelSobreVerde": "7.1:1",
    "grisSobrePapel": "5.1:1",
    "ambarTintaSobrePapel": "5.8:1",
    "ambarSobrePapel": "2.3:1 — prohibido como texto"
  }
}
